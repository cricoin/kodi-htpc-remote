<?xml version="1.0" encoding="UTF-8"?>
<!--
  Xiaomi/Redmi BLE remote (0005:2717:32B8), TV-like and simple for elderly users.
  X11 keys: Up/Down/Left/Right, Return (OK), XF86Back (Back), Home, Menu,
  Space (voice key via udev hwdb). Volume is handled by GNOME.
  Left/Right repeat while held is generated by htpc-remote (every 0.25 s).
  No long-press bindings: every key always does one thing.
-->
<keymap>
  <global>
    <keyboard>
      <home>ActivateWindow(Home)</home>
      <browser_back>Back</browser_back>
      <menu>ContextMenu</menu>
      <space>PlayPause</space>
    </keyboard>
  </global>
  <FullscreenVideo>
    <keyboard>
      <!-- OK: pause / resume -->
      <return>PlayPause</return>
      <!-- Left/Right: seek 10 s; hold = continuous seek -->
      <left>StepBack</left>
      <right>StepForward</right>
      <!-- Up/Down do nothing while playing -->
      <up>noop</up>
      <down>noop</down>
      <!-- Back: stop and return to the list (like a TV), no background playback -->
      <browser_back>Stop</browser_back>
      <!-- Menu: playback controls (subtitles / audio if ever needed) -->
      <menu>OSD</menu>
    </keyboard>
  </FullscreenVideo>
</keymap>
